/**
 * Turns the budget spreadsheet into supabase/seed-data.sql, which `supabase db reset` loads after seed.sql.
 *
 *   pnpm seed:xlsx <file.xlsx>
 *
 * Uses the same mapping as `pnpm import:xlsx` (including scripts/import/category-map.json — run
 * `pnpm import:xlsx <file.xlsx> --dry-run` first to review it) and checks the totals against the
 * sheet before writing. The output contains personal data and is gitignored.
 *
 * Options: --year 2026 (for sheets without a year), --email test@email.com (owner, from seed.sql)
 */
import { writeFileSync } from "node:fs";
import path from "node:path";
import { parseArgs } from "node:util";
import { categoryMapFor, forecastOf, incomeLines, readWorkbook, ym, yearsOf } from "./import/workbook";
import { chainMonths } from "../lib/domain/totals";
import { fromCents } from "../lib/domain/money";

const OUT_FILE = path.join(import.meta.dirname, "..", "supabase", "seed-data.sql");
const CATEGORIES = [
  "Housing & utilities", "Food", "Transport", "Subscriptions", "Insurance",
  "Shopping", "Health & care", "Fun & trips", "Credit card", "Other",
];

const { values, positionals } = parseArgs({
  allowPositionals: true,
  options: {
    year: { type: "string", default: "2026" },
    email: { type: "string", default: "test@email.com" },
  },
});
const file = positionals[0];
if (!file) {
  console.error("Usage: pnpm seed:xlsx <file.xlsx> [--year 2026] [--email test@email.com]");
  process.exit(1);
}

const sheet = await readWorkbook(file, Number(values.year));
const years = yearsOf(sheet);
const incomeOf = incomeLines(sheet);
const categoryMap = categoryMapFor(sheet);
const unknown = [...new Set(Object.values(categoryMap))].filter((c) => !CATEGORIES.includes(c));
if (unknown.length) throw new Error(`Unknown categories in the map: ${unknown.join(", ")}`);

// ---------- check the totals against the sheet before writing anything ----------

const chained = chainMonths(
  sheet.map((m) => ({
    year: m.year,
    month: m.month,
    savingsCents: m.savingsCents,
    openingBalanceCents: m.openingCents,
    incomeCents: incomeOf(m).map((l) => l.cents),
    items: m.items.map((it, i) => ({
      id: String(i), amountCents: it.cents, paid: it.paid, categoryId: "", isEstimate: false, isCreditBill: false,
      parentItemId: null,
    })),
  })),
  new Set(),
);
const wrong = sheet.filter((s) => {
  const app = chained.find((c) => c.year === s.year && c.month === s.month)!.totals;
  const prev = sheet.find((p) => ym(p) === ym(s) - 1);
  const carryOff = s.carryOff && prev ? forecastOf(prev) : 0; // the app always carries over (expected)
  return (
    Math.abs(app.availableNowCents - s.availableCents - carryOff) > 1 ||
    Math.abs(app.endForecastCents - forecastOf(s) - carryOff) > 1
  );
});
if (wrong.length) {
  console.error(`Totals don't match the sheet for: ${wrong.map((m) => `${m.month}/${m.year}`).join(", ")}`);
  process.exit(1);
}

// ---------- write the SQL ----------

const str = (s: string) => `'${s.replaceAll("'", "''")}'`;
const money = (cents: number) => fromCents(cents).toFixed(2);
const values_ = (rows: string[]) => rows.map((r) => `  (${r})`).join(",\n");

const monthRows = sheet.map(
  (m) => `${m.year}, ${m.month}, ${money(m.savingsCents)}, ${m.openingCents === null ? "null" : money(m.openingCents)}`,
);
const incomeRows = sheet.flatMap((m) =>
  incomeOf(m).map((l, i) => `${m.year}, ${m.month}, ${str(l.label)}, ${money(l.cents)}, ${l.recurring}, ${i}`),
);
// Items link to the regular bill of the same name; the n-th item with a name links to the n-th such bill.
const itemRows = sheet.flatMap((m) => {
  const seen = new Map<string, number>();
  return m.items.map((it) => {
    const name = it.name.trim();
    const nth = (seen.get(name.toLowerCase()) ?? 0) + 1;
    seen.set(name.toLowerCase(), nth);
    return `${m.year}, ${m.month}, ${str(name)}, ${money(it.cents)}, ${str(categoryMap[name])}, ${it.paid}, ${nth}`;
  });
});

const owner = `(select id from auth.users where email = ${str(values.email!)})`;

const sql = `-- Budget data from ${path.basename(file)} (${years.join(", ")}), generated by \`pnpm seed:xlsx\`.
-- Do not edit by hand: regenerate it instead. Contains personal data, so it is gitignored.
-- Loaded by \`supabase db reset\` after seed.sql, which creates the user, categories and bills.

do $$ begin
  if ${owner} is null then raise exception 'seed-data.sql: no user ${values.email}'; end if;
end $$;

delete from public.months
where user_id = ${owner} and year in (${years.join(", ")});

insert into public.months (user_id, year, month, savings, opening_balance)
select ${owner}, v.year, v.month, v.savings, v.opening
from (values
${values_(monthRows)}
) as v(year, month, savings, opening);

insert into public.income_entries (user_id, month_id, label, amount, is_recurring, sort_order)
select m.user_id, m.id, v.label, v.amount, v.recurring, v.ord
from (values
${values_(incomeRows)}
) as v(year, month, label, amount, recurring, ord)
join public.months m on m.user_id = ${owner} and m.year = v.year and m.month = v.month;

insert into public.items (user_id, month_id, name, amount, category_id, date, paid, is_estimate, bill_id)
select m.user_id, m.id, v.name, v.amount, c.id, make_date(v.year, v.month, 1), v.paid, false, b.id
from (values
${values_(itemRows)}
) as v(year, month, name, amount, category, paid, nth)
join public.months m on m.user_id = ${owner} and m.year = v.year and m.month = v.month
join public.categories c on c.user_id = m.user_id and c.name = v.category
left join (
  select id, user_id, lower(name) as lname, row_number() over (partition by user_id, lower(name) order by sort_order) as n
  from public.bills
) b on b.user_id = m.user_id and b.lname = lower(v.name) and b.n = v.nth;
`;

writeFileSync(OUT_FILE, sql);
console.log(
  `Wrote ${path.relative(process.cwd(), OUT_FILE)}: ${sheet.length} months (${years.join(", ")}), ` +
    `${incomeRows.length} income lines, ${itemRows.length} items. All months match the spreadsheet.`,
);
